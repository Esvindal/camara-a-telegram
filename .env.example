# Copiá este archivo a ".env" y completá tus valores. El .env NO se commitea.

# Fuente de eventos: simulator | dahua | hikvision
CAMARA_FUENTE=simulator

# Solo si CAMARA_FUENTE=dahua|hikvision. Usá SIEMPRE un usuario de solo lectura.
# CAMARA_URL=http://192.168.1.64
# CAMARA_USUARIO=
# CAMARA_CLAVE=

# Bot de Telegram (se crea con @BotFather). Nunca commitear.
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=

# Simulador
SIM_INTERVALO=5
# SIM_WEBCAM=0   # 1 para usar la webcam con el extra [webcam]

# Anti-spam: segundos de enfriamiento por tipo de evento
ENFRIAMIENTO_SEG=60

# Registro local
DB_PATH=datos/eventos.db

# Google Sheets (opcional, extra [sheets]) - NO VERIFICADO sin cuenta de servicio
# SHEETS_CREDENCIALES=ruta/a/credenciales.json
# SHEETS_PLANILLA=nombre-de-la-planilla
